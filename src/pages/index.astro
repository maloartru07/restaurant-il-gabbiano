---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import Cuisine from "../components/Cuisine.astro";
import Maison from "../components/Maison.astro";
import Avis from "../components/Avis.astro";
import InfosPratiques from "../components/InfosPratiques.astro";
import Footer from "../components/Footer.astro";
---

<Layout
  title="Il Gabbiano — Restaurant italien à Issy-les-Moulineaux"
  description="Il Gabbiano, trattoria italienne à Issy-les-Moulineaux : pizzas, pâtes et desserts maison, service à table et à emporter, petite terrasse. Note Tripadvisor 4,2/5 sur 49 avis."
>
  <Header />
  <main>
    <Hero />
    <Cuisine />
    <Maison />
    <Avis />
    <InfosPratiques />
  </main>
  <Footer />
</Layout>
