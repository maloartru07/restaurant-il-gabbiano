---
import { avis, avisGoogle, restaurant } from "../data/restaurant";

type Plateforme = {
  nom: string;
  note: number;
  noteMax: number;
  nombreAvis: number;
  precision?: string;
  avis: typeof avis;
};

const plateformes: Plateforme[] = [
  {
    nom: "Tripadvisor",
    note: restaurant.tripadvisor.note,
    noteMax: restaurant.tripadvisor.noteMax,
    nombreAvis: restaurant.tripadvisor.nombreAvis,
    precision: restaurant.tripadvisor.classement,
    avis,
  },
  {
    nom: "Google",
    note: restaurant.google.note,
    noteMax: restaurant.google.noteMax,
    nombreAvis: restaurant.google.nombreAvis,
    avis: avisGoogle,
  },
];
---

<section id="avis" class="bg-crema-50 py-20 sm:py-28">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <div class="max-w-2xl">
      <p class="text-sm font-semibold uppercase tracking-[0.2em] text-pomodoro-600">
        Avis clients
      </p>
      <h2 class="mt-3 font-serif text-3xl font-bold text-inchiostro-900 sm:text-4xl">
        Ce qu'on en dit sur Tripadvisor et Google
      </h2>
    </div>

    <div class="mt-8 flex flex-col gap-6 sm:flex-row sm:flex-wrap sm:gap-10">
      {
        plateformes.map((plateforme) => {
          const etoilesPleines = Math.round(plateforme.note);
          return (
            <div>
              <div class="flex items-center gap-3">
                <div class="flex text-pomodoro-600" aria-hidden="true">
                  {Array.from({ length: 5 }).map((_, i) => (
                    <svg
                      class="h-6 w-6"
                      viewBox="0 0 20 20"
                      fill={i < etoilesPleines ? "currentColor" : "none"}
                      stroke="currentColor"
                      stroke-width="1.5"
                    >
                      <path
                        d="M10 1.5l2.6 5.6 6.1.6-4.6 4.1 1.3 6-5.4-3-5.4 3 1.3-6-4.6-4.1 6.1-.6z"
                        stroke-linejoin="round"
                      />
                    </svg>
                  ))}
                </div>
                <p class="font-semibold text-inchiostro-900">
                  {plateforme.note.toFixed(1).replace(".", ",")} / {plateforme.noteMax}
                  <span class="font-normal text-inchiostro-800/70">
                    {" "}
                    · {plateforme.nombreAvis} avis {plateforme.nom}
                  </span>
                </p>
              </div>
              {plateforme.precision && (
                <p class="mt-1 text-sm text-inchiostro-800/70">{plateforme.precision}</p>
              )}
            </div>
          );
        })
      }
    </div>

    {
      plateformes.map((plateforme) => (
        <div class="mt-14 first:mt-12">
          <h3 class="font-serif text-xl font-bold text-inchiostro-900">
            Sur {plateforme.nom}
          </h3>
          <div class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {plateforme.avis.map((unAvis) => (
              <figure class="flex h-full flex-col justify-between rounded-2xl bg-white p-6 shadow-sm ring-1 ring-inchiostro-900/5">
                <blockquote class="font-serif text-lg leading-snug text-inchiostro-900">
                  « {unAvis.texte} »
                </blockquote>
                <figcaption class="mt-4 text-sm text-inchiostro-800/70">
                  <span class="font-semibold text-inchiostro-900">{unAvis.auteur}</span>
                  {" "}— {unAvis.date}
                  <br />
                  <span class="text-xs uppercase tracking-wide text-inchiostro-800/50">
                    Avis publié sur {plateforme.nom}
                  </span>
                </figcaption>
              </figure>
            ))}
          </div>
        </div>
      ))
    }
  </div>
</section>
