---
import PhotoSlot from "./PhotoSlot.astro";

const points = [
  {
    titre: "Un accueil chaleureux",
    texte:
      "Laura et l'équipe sont régulièrement citées pour leur accueil charmant et leur service rapide, dans une salle traditionnelle et reposante.",
  },
  {
    titre: "Une petite terrasse tranquille",
    texte:
      "Quand le temps s'y prête, la terrasse offre un coin calme pour déjeuner ou dîner à l'italienne.",
  },
  {
    titre: "À emporter",
    texte:
      "Envie d'Il Gabbiano chez vous ? Les plats sont aussi disponibles à emporter.",
  },
];
---

<section id="maison" class="bg-crema-100 py-20 sm:py-28">
  <div class="mx-auto grid max-w-6xl gap-12 px-4 sm:px-6 lg:grid-cols-2 lg:items-center">
    <PhotoSlot
      alt="Intérieur traditionnel et chaleureux du restaurant Il Gabbiano"
      teinte="basilico"
      class="h-72 w-full rounded-2xl sm:h-96"
    />

    <div>
      <p class="text-sm font-semibold uppercase tracking-[0.2em] text-basilico-600">
        La maison
      </p>
      <h2 class="mt-3 font-serif text-3xl font-bold text-inchiostro-900 sm:text-4xl">
        « Un petit restau qui ne paye pas de mine », mais qui a tout bon
      </h2>

      <dl class="mt-8 space-y-6">
        {
          points.map((point) => (
            <div>
              <dt class="font-serif text-lg font-bold text-inchiostro-900">
                {point.titre}
              </dt>
              <dd class="mt-1 text-inchiostro-800/80">{point.texte}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </div>
</section>
